[Unit]
Description=Stock Monitor -> Discord
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Ajustá el usuario y la ruta a donde subas la carpeta en tu VPS
User=tu_usuario
WorkingDirectory=/home/tu_usuario/stock-monitor
ExecStart=/home/tu_usuario/stock-monitor/venv/bin/python3 /home/tu_usuario/stock-monitor/monitor.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
